# Configurações do Ambiente Kore Framework
APP_ENV=local
APP_DEBUG=true

# Modo Multi-tenant: 'standalone' (banco unico) ou 'subdomain' (banco por subdominio)
TENANT_MODE=standalone

# Conexao com Banco de Dados
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kore_app
DB_USER=root
DB_PASS=

# Multi-tenant Subdomain Prefix/Suffix (usado apenas se TENANT_MODE=subdomain)
# Ex: {subdomain}_kore -> cliente1_kore
DB_PREFIX=
DB_SUFFIX=_kore